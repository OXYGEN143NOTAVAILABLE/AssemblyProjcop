{
  "entities": {
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private authenticated user profile and institutional identity metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 180
        },
        "studentId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["student", "instructor"]
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "displayName", "createdAt", "updatedAt"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Publicly visible non-PII user statistics and display handle.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["student", "instructor"]
        },
        "buildCount": {
          "type": "number"
        },
        "badgeCount": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "buildCount", "badgeCount", "updatedAt"]
    },
    "PublishedBuild": {
      "title": "PublishedBuild",
      "description": "PC assembly build record synced to Firestore.",
      "type": "object",
      "properties": {
        "buildId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "buildName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "score": {
          "type": "number"
        },
        "isPublished": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["buildId", "ownerUid", "buildName", "score", "isPublished", "createdAt", "updatedAt"]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Authorized Firebase administrator membership marker.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "assignedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "assignedAt"]
    },
    "ConnectionCheck": {
      "title": "ConnectionCheck",
      "description": "Sentinel connection verification document.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "maxLength": 32
        }
      },
      "required": ["status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserPrivate"
      },
      "description": "Private user PII and role metadata restricted to owner or admin."
    },
    "/publicProfiles/{userId}": {
      "schema": {
        "$ref": "#/entities/PublicProfile"
      },
      "description": "Publicly readable non-PII user display profile."
    },
    "/builds/{buildId}": {
      "schema": {
        "$ref": "#/entities/PublishedBuild"
      },
      "description": "PC builds owned by authenticated users."
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/AdminMember"
      },
      "description": "Admin role lookup collection."
    },
    "/test/{connectionId}": {
      "schema": {
        "$ref": "#/entities/ConnectionCheck"
      },
      "description": "Startup Firestore connection probe sentinel."
    }
  }
}
