rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'segoviajairus339@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprints (Anti-Update-Gap)
    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'studentId', 'role', 'displayName', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 180 &&
        (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 80)) &&
        data.role is string && data.role in ['student', 'instructor'] &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'buildCount', 'badgeCount', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'role', 'buildCount', 'badgeCount', 'updatedAt']) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role is string && data.role in ['student', 'instructor'] &&
        data.buildCount is number && data.buildCount >= 0 && data.buildCount <= 10000 &&
        data.badgeCount is number && data.badgeCount >= 0 && data.badgeCount <= 1000 &&
        data.updatedAt is timestamp;
    }

    function isValidBuild(data, buildId) {
      return data.keys().hasAll(['buildId', 'ownerUid', 'buildName', 'score', 'isPublished', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['buildId', 'ownerUid', 'buildName', 'summary', 'score', 'isPublished', 'createdAt', 'updatedAt']) &&
        data.buildId is string && data.buildId == buildId && isValidId(data.buildId) &&
        data.ownerUid is string && isValidId(data.ownerUid) &&
        data.buildName is string && data.buildName.size() >= 1 && data.buildName.size() <= 160 &&
        (!('summary' in data) || (data.summary is string && data.summary.size() <= 500)) &&
        data.score is number && data.score >= 0 && data.score <= 100 &&
        data.isPublished is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminMember(data, adminId) {
      return data.keys().hasAll(['uid', 'assignedAt']) &&
        data.keys().hasOnly(['uid', 'assignedAt']) &&
        data.uid is string && data.uid == adminId && isValidId(data.uid) &&
        data.assignedAt is timestamp;
    }

    // Private PII user credentials & profile metadata
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isVerified() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserPrivate(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() &&
        isValidId(userId) &&
        isValidUserPrivate(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'studentId', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Non-PII public display profiles
    match /publicProfiles/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if false;
      allow create: if isVerified() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidPublicProfile(incoming(), userId) &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/users/$(userId));
      allow update: if isVerified() &&
        isValidId(userId) &&
        isValidPublicProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'buildCount', 'badgeCount', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // PC builds synced to Firestore
    match /builds/{buildId} {
      allow get: if isValidId(buildId) && (
        existing().isPublished == true ||
        (isSignedIn() && existing().ownerUid == request.auth.uid) ||
        isAdmin()
      );
      allow list: if resource.data.isPublished == true ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isVerified() &&
        isValidId(buildId) &&
        isValidBuild(incoming(), buildId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerified() &&
        isValidId(buildId) &&
        isValidBuild(incoming(), buildId) &&
        incoming().buildId == existing().buildId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['buildName', 'summary', 'score', 'isPublished', 'updatedAt'])
          )
        );
      allow delete: if isVerified() &&
        isValidId(buildId) &&
        (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Admin membership markers (only manageable by bootstrapped admin)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if false;
      allow create: if isBootstrappedAdmin() &&
        isValidId(adminId) &&
        isValidAdminMember(incoming(), adminId) &&
        incoming().assignedAt == request.time;
      allow update: if false;
      allow delete: if isBootstrappedAdmin() && isValidId(adminId);
    }

    // Startup connection verification sentinel
    match /test/{connectionId} {
      allow get: if isValidId(connectionId) && connectionId == 'connection';
      allow list, write: if false;
    }
  }
}
