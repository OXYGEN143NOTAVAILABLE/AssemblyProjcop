DB_HOST=localhost
DB_PORT=5432
DB_NAME=pc_builder_simulation
DB_USER=your_postgres_user
DB_PASSWORD=replace_with_your_local_database_password

# Generate a unique value for each deployment (for example: python -c "import secrets; print(secrets.token_urlsafe(32))")
ADMIN_SECRET=replace_with_a_unique_random_secret

# Development server
APP_HOST=0.0.0.0
APP_PORT=5000
ENVIRONMENT=development

# Optional: add your LAN URL if you serve a separate frontend or need explicit CORS.
# Example: ALLOWED_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://192.168.1.25:5000
ALLOWED_CORS_ORIGINS=
